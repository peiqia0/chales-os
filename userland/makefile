# User programs are built against newlib (headers + libc.a) plus libchalessys.a,
# the chales-os syscall layer from ../libc/newlib. NEWLIB_PREFIX must point at a
# newlib install for $(HOST) (config.sh sets a default and checks it).
HOST?=$(shell ../default-host.sh)
CC=i686-elf-gcc
CFLAGS?=-O2 -g
CFLAGS:=$(CFLAGS) -ffreestanding -fno-pie -fno-stack-protector \
        -fno-asynchronous-unwind-tables -fno-unwind-tables -fno-ident \
        -std=gnu11 -Wall -Wextra

ifeq ($(NEWLIB_PREFIX),)
$(error NEWLIB_PREFIX is not set: point it at a newlib install for $(HOST))
endif
NEWLIB_INC:=$(NEWLIB_PREFIX)/$(HOST)/include
NEWLIB_LIB:=$(NEWLIB_PREFIX)/$(HOST)/lib

# -I puts newlib's headers ahead of the sysroot's (which only supply the
# kernel-side libc and chales-os' own <syscalls.h> / <sys/chales_abi.h>).
CPPFLAGS:=$(CPPFLAGS) -nostdinc -I$(NEWLIB_INC) -isystem $(shell $(CC) -print-file-name=include) -idirafter ../libc/include

LDFLAGS:=$(LDFLAGS) -nostdlib -Wl,-n -Wl,-s -Wl,--build-id=none

PROGRAMS:=hello uptime beep shell cowsay nltest
BINARIES:=$(PROGRAMS:=.elf)

KERNEL_INCLUDE_DIR:=../kernel/include/kernel
PROGRAMS_HEADER:=$(KERNEL_INCLUDE_DIR)/programs.h

all: $(BINARIES) $(PROGRAMS_HEADER)

%.o: %.c
	$(CC) -c $< -o $@ $(CFLAGS) $(CPPFLAGS)

%.elf: %.o crt0.o linker.ld ../libc/libchalessys.a
	$(CC) -T linker.ld -o $@ $(CFLAGS) $(LDFLAGS) crt0.o $< -L$(NEWLIB_LIB) -L../libc -Wl,--start-group -lchalessys -lc -lgcc -Wl,--end-group

$(PROGRAMS_HEADER): $(BINARIES) bin2header.sh
	@echo "/* Auto-generated by userland/Makefile via bin2header.sh — do not edit by hand. */" > $@
	@echo "/* Regenerated on every 'make' in userland/ from the *.elf built there.        */" >> $@
	@echo "#ifndef PROGRAMS_H" >> $@
	@echo "#define PROGRAMS_H" >> $@
	@echo "" >> $@
	@echo "#include <stddef.h>" >> $@
	@echo "#include <stdint.h>" >> $@
	@echo "" >> $@
	@for p in $(PROGRAMS); do \
		./bin2header.sh $$p.elf $${p}_elf --body >> $@ && echo "" >> $@ || exit 1; \
	done
	@echo "#endif /* PROGRAMS_H */" >> $@

.PHONY: all clean install install-headers

clean:
	rm -f $(PROGRAMS:=.o) crt0.o $(BINARIES) $(PROGRAMS_HEADER)
install-headers:
	# no headers to install
install: all
